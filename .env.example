# SIH-MAX Platform Configuration
# DEMO is safe for local replay. LIVE only labels the source mode; it does not create an enterprise connector.
CYBER_MODE=DEMO
CYBER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Security settings (optional for local development/demo)
CYBER_REQUIRE_API_KEY=false
CYBER_API_KEY=
CYBER_MAX_EVENT_BYTES=16384
